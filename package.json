    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.6.2",
    "prisma": "^5.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
