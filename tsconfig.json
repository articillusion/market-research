{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
    ,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": ["src"]
}
